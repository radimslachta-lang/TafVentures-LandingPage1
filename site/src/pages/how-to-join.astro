---
import Base from '../layouts/Base.astro';
import Shape from '../components/home/Shape.astro';
import Join from '../components/home/Join.astro';
import Programs from '../components/home/Programs.astro';
---
<Base title="How to join | Tafelberg Ventures">
    <section class="section page-head">
        <p class="label">How to join</p>
        <h1 class="section-h">Start by Telling Us What You Need</h1>
        <p class="section-lead">The platform is in its co-design phase. The first and most important step is our needs questionnaire — your answers decide what we build first. If you already have a concrete project, the questionnaire leads you on to a short pitch.</p>
    </section>
    <Shape />
    <Join />
    <Programs />
</Base>
