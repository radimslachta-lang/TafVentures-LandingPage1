---
import Base from '../layouts/Base.astro';
import Mission from '../components/home/Mission.astro';
import WhyNow from '../components/home/WhyNow.astro';
import Identity from '../components/home/Identity.astro';
---
<Base title="About us | Tafelberg Ventures">
    <section class="section page-head">
        <p class="label">About us</p>
        <h1 class="section-h">An Innovation Platform in the Making</h1>
        <p class="section-lead">Tafelberg Ventures is being built at FN Olomouc University Hospital to connect clinical practice, research, capital, and industry. We are at the very beginning — and we are building it together with the people it is meant to serve.</p>
    </section>
    <Mission />
    <WhyNow />
    <Identity />
    <section class="section" id="team">
        <p class="label">Team</p>
        <h2 class="section-h">The People Behind It</h2>
        <div class="team-placeholder">
            <p>We are putting the team together now. Introductions will follow here as the platform takes shape.</p>
        </div>
    </section>
</Base>
