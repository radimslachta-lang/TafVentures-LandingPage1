---
import '../styles/global.css';
import '../styles/nav.css';
import '../styles/home.css';
import Ticker from '../components/Ticker.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { langOf, alternate } from '../i18n.js';

const lang = langOf(Astro);
const defaultTitle = lang === 'cs'
    ? 'Tafelberg Ventures | Platforma pro zdravotnické inovace a venture building'
    : 'Tafelberg Ventures | Health Innovation & Venture Building Platform';
const { title = defaultTitle } = Astro.props;
const site = Astro.site ?? Astro.url;
const enHref = new URL(alternate(Astro.url.pathname, 'en'), site).href;
const csHref = new URL(alternate(Astro.url.pathname, 'cs'), site).href;
---
<!DOCTYPE html>
<html lang={lang}>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title}</title>
    <link rel="alternate" hreflang="en" href={enHref}>
    <link rel="alternate" hreflang="cs" href={csHref}>
    <link rel="alternate" hreflang="x-default" href={enHref}>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
</head>
<body>
<Ticker />
<Nav />
<slot />
<Footer />
<script is:inline defer src="/_vercel/insights/script.js"></script>
</body>
</html>
