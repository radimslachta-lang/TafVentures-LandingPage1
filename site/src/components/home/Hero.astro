---
import { langOf, pick } from '../../i18n.js';
const t = pick({
    en: {
        tag: 'Innovation Platform and HUB (in preparation)',
        sub: 'We are building a Health Innovation and Venture Building Platform at FN Olomouc — the simplest route for innovators into clinical practice and health data, and from research to real-world impact.',
        subStrong: 'And we want to build it with you.',
        cta: 'Help us build it →', explore: 'Explore the Platform', scroll: 'Scroll',
    },
    cs: {
        tag: 'Inovační platforma a HUB (v přípravě)',
        sub: 'Ve Fakultní nemocnici Olomouc budujeme platformu pro inovace ve zdravotnictví a rozvoj podnikatelských projektů (tzv. Venture Building). Představuje tu nejjednodušší cestu, jak mohou inovátoři proniknout do klinické praxe a k zdravotnickým datům – a jak přetavit výzkum v reálný dopad.',
        subStrong: 'A chceme ji budovat společně s vámi.',
        cta: 'Pomozte nám ji postavit →', explore: 'Prozkoumat platformu', scroll: 'Dolů',
    },
}, langOf(Astro));
---
<!-- ═══ HERO ═══ -->
<div class="hero">
    <div class="hero-glow"></div>
    <div class="hero-glow2"></div>
    <p class="hero-tag"><span style="color:#b21612">FN Olomouc</span> — {t.tag}</p>
    <h1 class="hero-title">
        <span class="ac">Tafelberg</span><br>Ventures
    </h1>
    <p class="hero-sub">{t.sub}<br><strong>{t.subStrong}</strong></p>
    <div class="hero-cta">
        <a href="#shape" class="btn btn-primary btn-lg">{t.cta}</a>
        <a href="#platform" class="btn btn-ghost btn-lg">{t.explore}</a>
    </div>
    <div class="scroll-hint">
        <div class="scroll-bar"></div>
        <span>{t.scroll}</span>
    </div>
</div>

<!-- ECG heartbeat divider -->
<div class="ecg-wrap">
    <svg viewBox="0 0 1200 50" preserveAspectRatio="none" style="width:100%;height:50px;display:block;opacity:.4">
        <path class="ecg-line ecg-anim" d="M0,25 L75,25 L93,22 L102,25 L110,3 L117,47 L124,14 L133,25
            L210,25 L300,25 L318,22 L327,25 L335,3 L342,47 L349,14 L358,25
            L435,25 L525,25 L543,22 L552,25 L560,3 L567,47 L574,14 L583,25
            L660,25 L750,25 L768,22 L777,25 L785,3 L792,47 L799,14 L808,25
            L885,25 L975,25 L993,22 L1002,25 L1010,3 L1017,47 L1024,14 L1033,25
            L1110,25 L1200,25"/>
    </svg>
</div>
