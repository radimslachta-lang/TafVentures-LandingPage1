---
import { langOf, pick } from '../../i18n.js';
// Source: Act No. 328/2025 Coll. on research, development, innovation and knowledge transfer
// (in force 1 Jan 2027), § 54(3), § 54(4), § 86(2). Do not claim the hospital may hold equity —
// that is not settled by this act.
const t = pick({
    en: {
        label: 'Why now', h: 'The Rules Are Changing in 2027',
        lead: 'From 1 January 2027, the new Czech Act on Research, Development, Innovation and Knowledge Transfer (No. 328/2025 Coll.) makes it considerably easier for public research organisations — university hospitals included — to bring their results to market. We want FN Olomouc to be ready on day one.',
        items: [
            { t: 'Simpler licensing', d: 'State-funded organisations will be able to license their own research results without the consent of their founding ministry — a faster, more direct way to work with companies.' },
            { t: 'A legal basis for spin-offs', d: 'Institutional support may be used to set up knowledge-transfer companies, with profits returning to research. Turning clinical research into ventures gets a clear legal footing.' },
            { t: 'Transfer becomes a duty', d: 'Knowledge transfer becomes a statutory part of research, with yearly reporting of licences and transfer companies. It is no longer an optional extra — it needs a home.' },
        ],
    },
    cs: {
        label: 'Proč právě teď', h: 'Od roku 2027 se mění pravidla',
        lead: 'Od 1. ledna 2027 nový zákon o výzkumu, vývoji, inovacích a transferu znalostí (č. 328/2025 Sb.) výrazně usnadní veřejným výzkumným organizacím — včetně fakultních nemocnic — uvádět výsledky výzkumu na trh. Chceme, aby FN Olomouc byla připravená od prvního dne.',
        items: [
            { t: 'Jednodušší licencování', d: 'Státní příspěvkové organizace budou moci licencovat vlastní výsledky výzkumu bez souhlasu zřizovatele — rychlejší a přímější cesta ke spolupráci s firmami.' },
            { t: 'Zákonná opora pro spin-offy', d: 'Institucionální podporu bude možné využít k založení transferových společností, jejichž zisk se vrací do výzkumu. Přeměna klinického výzkumu ve firmy tak získá jasný právní rámec.' },
            { t: 'Transfer se stává povinností', d: 'Transfer znalostí se stává zákonnou součástí výzkumu a licence i transferové společnosti se budou každoročně vykazovat. Už to není volitelný doplněk — potřebuje své zázemí.' },
        ],
    },
}, langOf(Astro));
---
<!-- ═══ WHY NOW ═══ -->
<section class="section why-now" id="why-now">
    <p class="label">{t.label}</p>
    <h2 class="section-h">{t.h}</h2>
    <p class="section-lead">{t.lead}</p>
    <div class="mission-pillars why-grid">
        {t.items.map((i) => (
            <div class="pillar">
                <div class="pillar-title">{i.t}</div>
                <p class="pillar-desc">{i.d}</p>
            </div>
        ))}
    </div>
</section>
