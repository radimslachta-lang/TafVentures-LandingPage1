---
import { intakeHref } from '../../data/site.js';

const href = intakeHref('en');
const linkAttrs = href.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {};
---
<!-- ═══ PARTNERS ═══ -->
<section class="section" id="partners">
    <p class="label">Partners &amp; Network</p>
    <h2 class="section-h">Building It Together</h2>
    <p class="section-lead">We are building the platform together with investors and innovators who share our goal — and we are looking for more.</p>
    <div class="partners-grid">
        <a class="partner partner-invert" href="https://www.dendiscapital.com/" target="_blank" rel="noopener">
            <img src="https://www.dendiscapital.com/wp-content/uploads/2023/11/Group-4140.svg" alt="Dendis Capital" onerror="this.style.display='none'">
            <span class="partner-label">Dendis Capital</span>
        </a>
        <a class="partner partner-invert" href="https://genespector.com/" target="_blank" rel="noopener">
            <img src="https://genespector.com/img/gs-logo.svg" alt="Genespector" onerror="this.style.display='none'">
            <span class="partner-label">Genespector</span>
        </a>
        <a class="partner" href="https://g-angels.cz/" target="_blank" rel="noopener">
            <img src="https://g-angels.cz/wp-content/uploads/2022/09/ga-black-final.svg" alt="Garage Angels" onerror="this.style.display='none'">
            <span class="partner-label">Garage Angels</span>
        </a>
        <a class="partner partner-open" href={href} {...linkAttrs}>
            <span class="partner-open-title">We are looking for more partners</span>
            <span class="partner-label">Become a partner →</span>
        </a>
    </div>
</section>
