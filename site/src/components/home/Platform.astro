            </svg>

            <!-- Overlay SVG: flow arrows — z-index 10, renders above all eco-boxes -->
            <!--
                SERVICES (blue)  — start at large hex boundary, arrow points outward into E.services space
                  • top-left:     large hex TL vertex (247,150) → outer upper-left (165,68)
                  • bottom-right: large hex BR vertex (593,350) → outer lower-right (675,434)
                  Both paths stay OUTSIDE the large hex — no eco-box crossings.

                SELECTION (green) — start in E.services space, arrow points inward to small hex boundary
                  • bottom-left: outer lower-left (155,415) → small hex left face (340,280)
                  • top-right:   outer upper-right (685,85) → small hex right face (500,220)
                  These paths cross the eco-player zone (unavoidable); overlay ensures visibility.

                Large hex vertices: TL(247,150) TR(593,150) BL(247,350) BR(593,350)
                Small hex faces:    left x=340 y=204–296 | right x=500 y=204–296
            -->
            <svg class="eco-svg-overlay" viewBox="0 0 840 480" fill="none" xmlns="http://www.w3.org/2000/svg">
                <defs>
                    <marker id="arrowSvc" markerWidth="11" markerHeight="11" refX="9" refY="5.5" orient="auto">
                        <path d="M0,1 L0,10 L10,5.5 z" fill="rgba(29,99,208,0.95)"/>
                    </marker>
                    <marker id="arrowSel" markerWidth="11" markerHeight="11" refX="9" refY="5.5" orient="auto">
                        <path d="M0,1 L0,10 L10,5.5 z" fill="rgba(178,22,18,0.95)"/>
                    </marker>
                </defs>

                <!-- SERVICES — top-left: hex TL vertex → upper-left outer space (no box crossings) -->
                <path d="M 247,150 Q 200,106 165,68"
                      stroke="rgba(29,99,208,0.88)" stroke-width="2.5" fill="none"
                      marker-end="url(#arrowSvc)" class="flow-svc"/>
                <text x="160" y="64" text-anchor="end"
                      font-family="'Space Mono',monospace" font-size="6.5" letter-spacing="1.3"
                      fill="rgba(29,99,208,0.85)">SUPPORT/SERVICES</text>

                <!-- SERVICES — bottom-right: hex BR vertex → lower-right outer space (no box crossings) -->
                <path d="M 593,350 Q 637,394 675,434"
                      stroke="rgba(29,99,208,0.88)" stroke-width="2.5" fill="none"
                      marker-end="url(#arrowSvc)" class="flow-svc"/>
                <text x="680" y="438" text-anchor="start"
                      font-family="'Space Mono',monospace" font-size="6.5" letter-spacing="1.3"
                      fill="rgba(29,99,208,0.85)">SUPPORT/SERVICES</text>

                <!-- SELECTION — bottom-left: lower-left outer → small hex left face y=280 -->
                <path d="M 155,415 Q 228,374 340,280"
                      stroke="rgba(178,22,18,0.88)" stroke-width="2.5" fill="none"
                      marker-end="url(#arrowSel)" class="flow-sel"/>
                <text x="148" y="420" text-anchor="end"
                      font-family="'Space Mono',monospace" font-size="6.5" letter-spacing="1.3"
                      fill="rgba(178,22,18,0.85)">APPLICATION/SELECTION</text>

                <!-- SELECTION — top-right: upper-right outer → small hex right face y=220 -->
                <path d="M 685,85 Q 612,128 500,220"
                      stroke="rgba(178,22,18,0.88)" stroke-width="2.5" fill="none"
                      marker-end="url(#arrowSel)" class="flow-sel"/>
                <text x="690" y="82" text-anchor="start"
                      font-family="'Space Mono',monospace" font-size="6.5" letter-spacing="1.3"
                      fill="rgba(178,22,18,0.85)">APPLICATION/SELECTION</text>
            </svg>

