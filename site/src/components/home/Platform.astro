                <line x1="332" y1="89"  x2="420" y2="250" stroke="rgba(29,99,208,0.28)"  stroke-width="1.5" stroke-dasharray="5 4"/>
                <line x1="507" y1="89"  x2="420" y2="250" stroke="rgba(29,99,208,0.28)"  stroke-width="1.5" stroke-dasharray="5 4"/>
                <line x1="332" y1="401" x2="420" y2="250" stroke="rgba(178,22,18,0.2)"  stroke-width="1.5" stroke-dasharray="5 4"/>
